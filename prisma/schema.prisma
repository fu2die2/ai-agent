generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memo {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  @@map("memos")
}

model KnowledgeChunk {
  id         String   @id
  documentId String
  chunkIndex Int
  title      String
  category   String
  source     String
  content    String
  keywords   String   @default("")
  embedding  Json
  model      String
  corpusHash String
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([corpusHash])
  @@map("knowledge_chunks")
}
